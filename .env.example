PORT=8787
APP_MODE=local

# Resemble TTS (legacy local mode voice output)
RESEMBLE_API_KEY=
RESEMBLE_VOICE_UUID=fb2d2858
RESEMBLE_MODEL=chatterbox-turbo
RESEMBLE_SAMPLE_RATE=24000
RESEMBLE_SYNTH_ENDPOINT=https://p.cluster.resemble.ai/synthesize
RESEMBLE_STREAM_ENDPOINT=https://p.cluster.resemble.ai/stream

# STT options: local | mock
STT_MODE=local

# TTS options: local | mock
TTS_MODE=local

# Natural turn-taking latency window (ms)
TURN_LATENCY_MIN_MS=300
TURN_LATENCY_MAX_MS=500

# Twilio media stream WS URL base. Example with ngrok:
# wss://abcd-1234.ngrok-free.app
TWILIO_STREAM_WSS_URL=

# Twilio front desk transfer number
FRONT_DESK_NUMBER=+15551230000
